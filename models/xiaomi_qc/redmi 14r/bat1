echo 测试fastboot环境
fastboot erase frp
if errorlevel 1 (
    echo [错误] Fastboot状态有误 BL未解锁且工程abl已被覆盖
    pause
    exit /b 1
)

echo 刷入破解lun4分区
fastboot flash partition:4 ./main/gpt_both4.bin
if errorlevel 1 (
    echo [错误] Fastboot状态有误 您的设备已变砖 请联系售后处理
    pause
    exit /b 1
