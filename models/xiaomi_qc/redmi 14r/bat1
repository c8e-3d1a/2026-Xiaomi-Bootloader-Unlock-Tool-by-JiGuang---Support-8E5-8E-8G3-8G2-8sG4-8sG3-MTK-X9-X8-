@echo off
chcp 65001
chcp 936 >nul
setlocal enabledelayedexpansion
for /F %%a in ('echo prompt $E ^| cmd') do set "ESC=%%a"
title JiGuang_4Gen2(1/2)_BootLoader_ULOCKING TOOL
color 0A

echo ==================================================
echo     Welcome JiGuang BootLoader_ULOCKING TOOL
echo     作者：酷安 @AC极光_Official
echo     QQ:2130275658
echo     team:709619081
echo ==================================================

echo Make sure:
echo  1. 手机已进入 usb调试模式并连接电脑
echo  2. 电脑已安装 adb 和 fastboot 驱动
echo.
pause
cls

:: 检查 adb 和 fastboot 是否可用
where adb >nul 2>nul
if errorlevel 1 (
    echo [错误] 未找到 adb 命令，请安装并添加到 PATH。
    pause
    exit /b 1
)
where fastboot >nul 2>nul
if errorlevel 1 (
    echo [错误] 未找到 fastboot 命令，请安装并添加到 PATH。
    pause
    exit /b 1
)

echo ==============================
echo       %GRN%选择对应版本%RST%
echo       1.可宽容版本(2月补丁前)(默认)
echo       2.临时bl模式
echo       3.OS1模式
echo ==============================

set /p choice=请输入对应数字后回车: 
if "%choice%"=="1" (
    goto set_Permissive
    )
if "%choice%"=="2" (
    goto flash
    )  
if "%choice%"=="3" (
    goto lsROOT
    ) 
set "ifFlash="
set "main="
echo ================================================
echo 文件路径:
echo       %YEL%./main/abl.elf"
echo       %YEL%./main/facabl.img"
echo       %YEL%./main/gpt_both4.bin%RST%
echo       %YEL%./gpt/gpt_both4.bin%RST%
echo ================================================
:set_Permissive
echo [1] 检查 Fastboot 设备...
fastboot devices | find "fastboot" >nul
if errorlevel 1 (
    echo [错误] 未检测到 Fastboot 设备，请确保手机已进入 Fastboot 模式并连接电脑。
    pause
    exit /b 1
)
echo [成功] 检测到 Fastboot 设备。

echo [2] 发送 fastboot 指令：设置 selinux 为宽容模式...
fastboot oem set-gpu-preemption 0 androidboot.selinux=permissive
if errorlevel 1 (
    echo [警告] fastboot oem 命令可能失败，继续尝试启动...
) else (
    echo [成功] 已发送 selinux 宽容模式指令。
)

echo 发送 fastboot continue 指令...
fastboot continue
if errorlevel 1 (
    echo [错误] fastboot continue 失败，请检查手机状态。
    pause
    exit /b 1
)
echo [成功] 手机正在重启，请稍候...

echo [3/3] 等待手机启动（约30秒）...
timeout /t 30 /nobreak >nul

echo 请将手机打开USB调试并允许调试
adb devices
if errorlevel 1 (
    echo [错误] 未检测到设备，请确保手机已打开调试并连接电脑。
    pause
    exit /b 1
) 
echo 推送abl分区文件 
adb push ./main/abl.img /data/local/tmp/
if errorlevel 1 (
    echo 推送abl分区文件 失败 请确保已经允许调试
    pause
    exit /b 1    
)
echo 刷入abl_a(1/2)
adb shell service call  miui.mqsas.IMQSNative 21 i32 1 s16 "dd" i32 1 s16 'if=/data/local/tmp/abl.img of=/dev/block/by-name/abl_a' s16 '/data/mqsas/log.txt' i32 60
if errorlevel 1 (
    echo 刷入abl_a 失败 请检查手机状态
    pause
    exit /b 1
)
echo 刷入abl_b(2/2)
adb shell service call  miui.mqsas.IMQSNative 21 i32 1 s16 "dd" i32 1 s16 'if=/data/local/tmp/abl.img of=/dev/block/by-name/abl_b' s16 '/data/mqsas/log.txt' i32 60
if errorlevel 1 (
    echo 刷入abl_b 失败 请检查手机状态
    pause
    exit /b 1
)
echo 正在重启到fastboot 此处请不要动手机 否则将会喜提黑砖
adb reboot bootloader
echo 等待10秒
timeout /t 10 /nobreak >nul
goto flash

:lsROOT
:: 检查 fastboot 设备
echo [1/3] 检查 Fastboot 设备...
fastboot devices | find "fastboot" >nul
if errorlevel 1 (
    echo [错误] 未检测到 Fastboot 设备，请确保手机已进入 Fastboot 模式并连接电脑。
    pause
    exit /b 1
)
echo [成功] 检测到 Fastboot 设备。

:: 执行 fastboot 命令
echo [2/3] 发送 fastboot 指令：设置 selinux 为宽容模式...
fastboot oem set-gpu-preemption 0 androidboot.selinux=permissive
if errorlevel 1 (
    echo [警告] fastboot oem 命令可能失败，继续尝试启动...
) else (
    echo [成功] 已发送 selinux 宽容模式指令。
