    exit /b 1
)
echo [成功] 手机正在重启，请稍候...

:: 简单等待手机启动
echo [3/3] 等待手机启动（约30秒）...
timeout /t 30 /nobreak >nul

echo 请将手机打开USB调试并允许调试
adb devices
if errorlevel 1 (
    echo [错误] 未检测到设备，请确保手机已打开调试并连接电脑。
    pause
    exit /b 1
)
echo 推送abl分区文件 
adb push ./main/abl.img /data/local/tmp/
if errorlevel 1 (
    echo 推送abl分区文件 失败 请确保已经允许调试
    pause
    exit /b 1    
)
echo 安装KSU获取临时Root
adb install ./ksu.APK
if errorlevel 1 (
    echo 安装ksu 失败 请确保已经允许调试
    pause
    exit /b 1    
)
echo [1]先在KernelSU app里面点击“越狱” 然后点超级用户 给shell授权权限
echo [2]等会命令行出现“$”时输入：su
timeout /t 30 /nobreak >nul
echo [3]出现“#”时依次输入以下代码：
echo 1：dd if=/data/local/tmp/abl.img of=/dev/block/by-name/abl\_a bs=4096 conv=fsync
echo 2：dd if=/data/local/tmp/abl.img of=/dev/block/by-name/abl\_b bs=4096 conv=fsync
echo 检查刷入无误后输入4：reboot bootloader

adb shell
if errorlevel 1 (
    echo [错误] 未检测到设备，请确保手机已打开调试并连接电脑。
    pause
    exit /b 1
)
echo 等待10秒
